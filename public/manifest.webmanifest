{
  "name": "ReportMD",
  "short_name": "ReportMD",
  "description": "Markdownで書けるLaTeX風レポート作成アプリ",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#43836c",
  "background_color": "#fbfcfb",
